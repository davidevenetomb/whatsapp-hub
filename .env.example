PORT=3000

# Token per autenticare il pannello admin (Authorization: Bearer <ADMIN_TOKEN>)
# Genera un valore tuo, es: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# URL pubblico usato per costruire i link di pairing (es. https://xxxx.trycloudflare.com)
PUBLIC_BASE_URL=http://localhost:3000

DATA_PATH=./data/db.json
SESSIONS_PATH=./sessions

DEFAULT_COUNTRY=IT
DEFAULT_MIN_DELAY_SECONDS=10
DEFAULT_MAX_DELAY_SECONDS=60
DEFAULT_MAX_MESSAGES_PER_DAY=150

# Opzionali: se assenti, le allerte vengono solo loggate
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
